<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta name="viewport"
        content="width=device-width, initial-scale=1.0">

  <title>Project ITECH - Student Product Posters</title>

  <style>

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      background: #f4f6f8;
      color: #222;
    }

    .page {
      max-width: 1100px;
      margin: auto;
      padding: 28px 18px 40px;
    }

    .header {
      text-align: center;
      margin-bottom: 22px;
    }

    .header h1 {
      margin: 0;
      font-size: 32px;
      font-weight: 700;
    }

    .header p {
      margin: 7px 0 0;
      color: #666;
      font-size: 16px;
    }

    .carousel {
      position: relative;
      background: white;
      border-radius: 18px;
      padding: 18px;
      box-shadow: 0 5px 24px rgba(0,0,0,.10);
    }

    .poster-area {
      min-height: 520px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #f1f3f5;
      border-radius: 14px;
      overflow: hidden;
    }

    .poster {
      display: block;
      max-width: 100%;
      max-height: 520px;
      width: auto;
      height: auto;
      object-fit: contain;
    }

    .arrow {
      position: absolute;
      top: 245px;
      z-index: 3;
      width: 46px;
      height: 46px;
      border: 0;
      border-radius: 50%;
      background: rgba(0,0,0,.65);
      color: white;
      font-size: 30px;
      cursor: pointer;
    }

    .arrow:hover {
      background: rgba(0,0,0,.85);
    }

    .prev {
      left: 28px;
    }

    .next {
      right: 28px;
    }

    .info {
      text-align: center;
      padding: 20px 10px 8px;
    }

    .product-name {
      font-size: 26px;
      font-weight: 700;
      margin-bottom: 7px;
    }

    .student {
      color: #777;
      font-size: 15px;
      margin-bottom: 10px;
    }

    .description {
      max-width: 800px;
      margin: auto;
      color: #444;
      font-size: 16px;
      line-height: 1.5;
    }

    .dots {
      text-align: center;
      margin: 14px 0 4px;
    }

    .dot {
      display: inline-block;
      width: 9px;
      height: 9px;
      margin: 4px;
      border-radius: 50%;
      background: #cbd5e1;
      cursor: pointer;
    }

    .dot.active {
      background: #2563eb;
      transform: scale(1.25);
    }

    .thumbs {
      display: flex;
      justify-content: center;
      gap: 9px;
      overflow-x: auto;
      padding: 12px 4px 3px;
    }

    .thumb {
      flex: 0 0 auto;
      width: 70px;
      height: 70px;
      object-fit: cover;
      border-radius: 8px;
      border: 2px solid transparent;
      opacity: .55;
      cursor: pointer;
    }

    .thumb.active {
      opacity: 1;
      border-color: #2563eb;
    }

    .status {
      text-align: center;
      padding: 70px 20px;
      color: #666;
      font-size: 18px;
    }

    .error {
      color: #b91c1c;
      text-align: center;
      padding: 50px 20px;
      line-height: 1.5;
    }

    @media (max-width: 700px) {

      .page {
        padding: 18px 10px 30px;
      }

      .header h1 {
        font-size: 25px;
      }

      .poster-area {
        min-height: 400px;
      }

      .poster {
        max-height: 400px;
      }

      .arrow {
        top: 185px;
        width: 40px;
        height: 40px;
        font-size: 25px;
      }

      .prev {
        left: 16px;
      }

      .next {
        right: 16px;
      }

      .product-name {
        font-size: 22px;
      }

    }

  </style>

</head>


<body>

<div class="page">

  <div class="header">

    <h1>PROJECT ITECH</h1>

    <p>
      Student Product Posters
    </p>

  </div>


  <div id="status"
       class="status">

    Loading approved posters...

  </div>


  <div id="carousel"
       class="carousel"
       style="display:none;">


    <button class="arrow prev"
            onclick="previousSlide()">

      ‹

    </button>


    <button class="arrow next"
            onclick="nextSlide()">

      ›

    </button>


    <div class="poster-area">

      <img id="poster"
           class="poster"
           alt="Student Product Poster">

    </div>


    <div class="info">

      <div id="productName"
           class="product-name">
      </div>


      <div id="student"
           class="student">
      </div>


      <div id="description"
           class="description">
      </div>

    </div>


    <div id="dots"
         class="dots">
    </div>


    <div id="thumbs"
         class="thumbs">
    </div>


  </div>

</div>


<script>


  /* ==========================================
     PROJECT ITECH GOOGLE APPS SCRIPT API
     ========================================== */

  const API_URL =
    "https://script.google.com/macros/s/AKfycbyO7BaYkjDmcg2asavZbvPFYpSFr_Uz7ntEUMyWEw-25QF-pzeDBl573Vx1VFw4snXyvw/exec";


  let products = [];

  let currentIndex = 0;

  let timer = null;


  /* ==========================================
     RECEIVE DATA FROM GOOGLE APPS SCRIPT
     ========================================== */

  function projectItechProducts(data) {

    console.log("Approved products:", data);


    products =
      Array.isArray(data)
        ? data
        : [];


    if (!products.length) {

      document.getElementById("status").innerHTML =
        "No approved posters are available yet.";

      return;

    }


    document.getElementById("status")
      .style.display = "none";


    document.getElementById("carousel")
      .style.display = "block";


    render();

    startAutoSlide();

  }


  /* ==========================================
     DISPLAY CURRENT POSTER
     ========================================== */

  function render() {

    const item =
      products[currentIndex];


    document.getElementById("poster")
      .src = item.imageUrl || "";


    document.getElementById("productName")
      .textContent =
        item.productName ||
        "Untitled Product";


    document.getElementById("student")
      .textContent =
        (item.studentName || "") +
        (item.section
          ? " • " + item.section
          : "");


    document.getElementById("description")
      .textContent =
        item.productDescription || "";


    renderDots();

    renderThumbs();

  }


  /* ==========================================
     DOTS
     ========================================== */

  function renderDots() {

    const dots =
      document.getElementById("dots");


    dots.innerHTML = "";


    products.forEach(function(item, index) {

      const dot =
        document.createElement("span");


      dot.className =
        "dot" +
        (index === currentIndex
          ? " active"
          : "");


      dot.onclick =
        function() {

          goTo(index);

        };


      dots.appendChild(dot);

    });

  }


  /* ==========================================
     THUMBNAILS
     ========================================== */

  function renderThumbs() {

    const thumbs =
      document.getElementById("thumbs");


    thumbs.innerHTML = "";


    products.forEach(function(item, index) {

      const img =
        document.createElement("img");


      img.className =
        "thumb" +
        (index === currentIndex
          ? " active"
          : "");


      img.src =
        item.imageUrl || "";


      img.alt =
        item.productName ||
        "Poster";


      img.onclick =
        function() {

          goTo(index);

        };


      thumbs.appendChild(img);

    });

  }


  /* ==========================================
     NEXT
     ========================================== */

  function nextSlide() {

    if (!products.length)
      return;


    currentIndex =
      (currentIndex + 1)
      % products.length;


    render();

    restartAutoSlide();

  }


  /* ==========================================
     PREVIOUS
     ========================================== */

  function previousSlide() {

    if (!products.length)
      return;


    currentIndex =
      (currentIndex - 1 +
       products.length)
      % products.length;


    render();

    restartAutoSlide();

  }


  /* ==========================================
     GO TO SPECIFIC POSTER
     ========================================== */

  function goTo(index) {

    currentIndex = index;

    render();

    restartAutoSlide();

  }


  /* ==========================================
     AUTOMATIC SLIDESHOW
     ========================================== */

  function startAutoSlide() {

    clearInterval(timer);


    timer =
      setInterval(function() {

        if (products.length > 1) {

          currentIndex =
            (currentIndex + 1)
            % products.length;


          render();

        }

      }, 6000);

  }


  function restartAutoSlide() {

    startAutoSlide();

  }


  /* ==========================================
     ERROR
     ========================================== */

  function showError(message) {

    document.getElementById("status")
      .innerHTML =
        '<div class="error">' +
        message +
        "</div>";

  }


  /* ==========================================
     CALL GOOGLE APPS SCRIPT
     ========================================== */

  const script =
    document.createElement("script");


  script.src =
    API_URL +
    "?api=products" +
    "&callback=projectItechProducts" +
    "&_=" +
    Date.now();


  script.onerror =
    function() {

      showError(
        "The carousel could not connect to the Project ITECH poster database."
      );

    };


  document.body.appendChild(script);


</script>


</body>

</html>
